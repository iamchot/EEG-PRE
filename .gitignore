.DS_Store

# ---- Secrets (never commit real credentials) ----
backend/.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Test / coverage artifacts ----
backend/.pytest_temp/
backend/tmp/
.coverage
htmlcov/
.pytest_cache/

# ---- Frontend build output ----
frontend/dist/
frontend/.angular/

# ---- Test runner caches ----
.tmp/
tmp/

# ---- Editor ----
.vscode/
*.swp
*.swo

# ---- Research data (participant-level EEG recordings — personal data) ----
backend/collection_data/

# ---- Large video stimulus assets (use Git LFS or host separately) ----
backend/collection_stimuli/**/*.mp4
frontend/src/assets/**/*.mp4

# ---- One-off scratch/temp directories ----
backend/scratch/
backend/tmp-review-locks/
offline-task1.sql
/work
