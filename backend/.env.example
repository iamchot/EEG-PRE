# ==========================================
# Dream Comicverse — Backend Environment
# ==========================================

# ---- Application ----
APP_ENV=development
SECRET_KEY=change-me-to-a-random-256bit-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (MySQL via Docker) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=dreamcomic
DB_PASSWORD=dreamcomic_pass
DB_NAME=dreamcomic
DATABASE_URL=mysql+pymysql://dreamcomic:dreamcomic_pass@localhost:3306/dreamcomic

# ---- AI: Gemini ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ---- AI: ComfyUI (Local Stable Diffusion) ----
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_OUTPUT_DIR=./comfyui_outputs

# ---- EEG / Recording ----
RAW_EEG_DIR=./recordings
BASELINE_SECONDS=20
ACCEPTED_RECORDING_SECONDS=30
WALL_CLOCK_TIMEOUT_SECONDS=120
RESUME_STABLE_SECONDS=2

# ---- Emotion Classification (Rule version) ----
EMOTION_RULE_VERSION=v1.0
